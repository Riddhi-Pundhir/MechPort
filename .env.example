# ==============================================================================
# MechPort - Central Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and replace placeholder values with your actual setup:
#   cp .env.example .env
#
# DO NOT commit real passwords, secrets, or specific credentials to git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NETWORK & WI-FI (Airtel Hotspot)
# ------------------------------------------------------------------------------
# Used by ESP32-CAM and reference documentation
WIFI_SSID="YOUR_AIRTEL_HOTSPOT_NAME"
WIFI_PASSWORD="YOUR_AIRTEL_HOTSPOT_PASSWORD"

# ------------------------------------------------------------------------------
# 2. RASPBERRY PI HTTP SERVER CONFIGURATION
# ------------------------------------------------------------------------------
# IP address and port the Raspberry Pi Flask server listens on
RPI_HOST="0.0.0.0"
RPI_PORT=5000

# ------------------------------------------------------------------------------
# 3. RASPBERRY PI GPIO PIN CONFIGURATION (BCM Numbering)
# ------------------------------------------------------------------------------
# Set these to the physical BCM GPIO pin numbers connected to your L298N driver.
# DO NOT GUESS! Check your jumper wire connections to the Pi header.
#
# ENA and ENB control motor speed using PWM.
# If you have the 5V jumper caps plugged onto the L298N ENA and ENB pins,
# leave them as empty / None to run at full speed without PWM wiring.
#
# Example BCM assignments if wired: ENA=12, IN1=17, IN2=27, IN3=22, IN4=23, ENB=13
PIN_ENA=
PIN_IN1=
PIN_IN2=
PIN_IN3=
PIN_IN4=
PIN_ENB=

# ------------------------------------------------------------------------------
# 4. MOTOR SAFETY & PERFORMANCE TUNING
# ------------------------------------------------------------------------------
# Watchdog timeout in seconds: motors will automatically STOP if no new command
# is received within this duration.
WATCHDOG_TIMEOUT_SECONDS=1.5

# Default motor speed percentage (0 to 100) if PWM is enabled
DEFAULT_SPEED=80

# PWM Frequency in Hertz (typically 100-1000 Hz for L298N)
PWM_FREQUENCY_HZ=100

# Force mock mode (True for laptop dry-runs without Raspberry Pi hardware)
ENABLE_MOCK_GPIO=False

# ------------------------------------------------------------------------------
# 5. ESP32-CAM CONFIGURATION
# ------------------------------------------------------------------------------
# IP address or full stream URL of your ESP32-CAM once it connects to your hotspot
# Example: http://192.168.1.50:81/stream or http://192.168.1.50/
ESP32_CAM_STREAM_URL="http://192.168.1.50:81/stream"
